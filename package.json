{
  "name": "lumen-ai-chat",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 41789",
    "dev:server": "cargo run --manifest-path backend/Cargo.toml",
    "build": "vue-tsc -b && vite build",
    "build:server": "cargo build --manifest-path backend/Cargo.toml --workspace",
    "check:server": "cargo fmt --manifest-path backend/Cargo.toml --all --check && cargo clippy --manifest-path backend/Cargo.toml --workspace --all-targets -- -D warnings && cargo test --manifest-path backend/Cargo.toml --workspace",
    "typecheck": "vue-tsc -b && vue-tsc -b tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:podman": "playwright test --config playwright.podman.config.ts",
    "audit": "npm audit --audit-level=low && cargo audit --file backend/Cargo.lock && cargo deny --manifest-path backend/Cargo.toml check",
    "test:watch": "vitest",
    "test:e2e:only": "playwright test",
    "test:e2e:report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "version:check": "node scripts/version-check.mjs",
    "release": "node scripts/release.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:server": "cargo llvm-cov --manifest-path backend/Cargo.toml --workspace --summary-only"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "^4.13.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.1.1"
  }
}
