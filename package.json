{
  "name": "lumen-ai-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 41789",
    "dev:server": "cargo run --manifest-path backend/Cargo.toml",
    "build": "vue-tsc -b && vite build",
    "build:server": "cargo build --manifest-path backend/Cargo.toml",
    "check:server": "cargo fmt --manifest-path backend/Cargo.toml --check && cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path backend/Cargo.toml",
    "typecheck": "vue-tsc -b",
    "test": "vitest run",
    "test:e2e": "node tests/run-e2e.mjs",
    "test:podman": "node tests/podman-smoke.mjs",
    "audit": "npm audit --audit-level=low && cargo audit --file backend/Cargo.lock && cargo deny --manifest-path backend/Cargo.toml check",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.3",
    "tailwindcss": "^4.1.14",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "concurrently": "^9.2.1",
    "@vue/tsconfig": "^0.8.1",
    "jsdom": "^27.0.0",
    "playwright-core": "^1.62.1",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  }
}
